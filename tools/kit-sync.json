{
  "sources": {
    "obsidian-kit": {
      "ref": "0.59.0"
    },
    "code-kit": {
      "ref": "0.24.0"
    }
  },
  "targets": [
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "endpoint",
        "endpoint_config",
        "endpoint_diagnostics",
        "i18n",
        "model-choice",
        "model-list-cache",
        "num",
        "reasoning",
        "sampling-profiles",
        "secrets",
        "settings",
        "settings_schema",
        "sha256",
        "think-splitter",
        "timeout"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/web",
      "modules": [
        "cache-download"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "frontmatter",
        "image-gen-provider"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "endpoint-source",
        "endpoint-secret-hook"
      ],
      "rewrite": [
        [
          "../vendor/code-kit/pure/",
          "./"
        ]
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "clock",
        "confirm",
        "endpoint-secrets",
        "endpoint-source",
        "folder-suggest",
        "help-setting",
        "hub",
        "model-picker",
        "secrets",
        "settings_walker",
        "shortcuts-bridge"
      ],
      "rewrite": [
        [
          "../vendor/code-kit/pure/",
          "../kit/"
        ],
        [
          "../pure/",
          "../kit/"
        ]
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "kit-css"
      ]
    }
  ]
}
